<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="14dp"
    android:paddingEnd="22dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_dot"
        android:backgroundTint="#4D6B7690" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/dot_status"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_dot"
            android:backgroundTint="@color/status_off" />

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_state"
            style="@style/ChipText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_neutral"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <include
        android:id="@+id/row_phys"
        layout="@layout/item_info_row" />

    <include
        android:id="@+id/row_proto"
        layout="@layout/item_info_row" />

    <include
        android:id="@+id/row_ipv4"
        layout="@layout/item_info_row" />

    <include
        android:id="@+id/row_mask"
        layout="@layout/item_info_row" />

    <include
        android:id="@+id/row_ipv6"
        layout="@layout/item_info_row" />

    <include
        android:id="@+id/row_mac"
        layout="@layout/item_info_row" />

    <include
        android:id="@+id/row_rxpkt"
        layout="@layout/item_info_row" />

    <include
        android:id="@+id/row_txpkt"
        layout="@layout/item_info_row" />

    <include
        android:id="@+id/row_rx"
        layout="@layout/item_info_row" />

    <include
        android:id="@+id/row_tx"
        layout="@layout/item_info_row" />

    <Button
        android:id="@+id/btn_restart_interface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/primary"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textAllCaps="false"
        android:textColor="@color/white" />
</LinearLayout>
